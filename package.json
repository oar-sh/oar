{
  "name": "copilot-remote",
  "version": "1.0.0",
  "type": "module",
  "description": "Web proxy for GitHub Copilot CLI — relay messages between browser and CLI",
  "main": "server/server.js",
  "bin": {
    "copilot-remote": "./bin/copilot-remote.js"
  },
  "scripts": {
    "start": "node server/server.js",
    "copilot:relay": "gh copilot -- --allow-all",
    "test": "node --test \"server/**/*.test.mjs\" \"shared/**/*.test.mjs\" \".github/extensions/web-relay/**/*.test.mjs\"",
    "test:agents:smoke": "node --test \"tests/agents/**/*.test.mjs\"",
    "test:e2e": "node tests/run-e2e.mjs",
    "test:e2e:raw": "node ./node_modules/@playwright/test/cli.js test --config tests/playwright.config.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.226",
    "@cursor/sdk": "^1.0.27",
    "better-sqlite3": "^12.10.0",
    "express": "^4.18.2",
    "socket.io": "^4.7.5",
    "uuid": "^14.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "cloudflared": "^0.7.1",
    "tty-console": "^1.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "jsdom": "^30.0.1"
  },
  "overrides": {
    "undici": "6.28.0"
  }
}
