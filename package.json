{
  "name": "@oar-sh/oar",
  "version": "0.9.18",
  "type": "module",
  "description": "OAR — Open Agent Relay: drive your local coding agents from any browser",
  "license": "MIT",
  "homepage": "https://oar.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oar-sh/oar.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "main": "server/server.js",
  "bin": {
    "oar": "./bin/oar.js"
  },
  "files": [
    "bin/",
    "server/",
    "!server/**/*.test.mjs",
    "!server/**/*-test-harness.mjs",
    "!server/**/fixtures/",
    "!server/README.md",
    "!server/data/",
    "!server/logs/",
    "!server/config.json",
    "!server/uploads/",
    "server/uploads/README.md",
    "shared/",
    "!shared/**/*.test.mjs",
    "!shared/**/*-test-harness.mjs",
    "!shared/**/fixtures/",
    ".github/extensions/web-relay/",
    "!.github/extensions/web-relay/**/*.test.mjs",
    "!.github/extensions/web-relay/README.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "preinstall": "node server/services/package-data-rescue-preinstall.mjs",
    "start": "node server/server.js",
    "copilot:relay": "gh copilot -- --allow-all",
    "test": "node --import ./scripts/node-test-keep-alive.mjs --test \"server/**/*.test.mjs\" \"shared/**/*.test.mjs\" \".github/extensions/web-relay/**/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "test:agents:smoke": "node --test \"tests/agents/**/*.test.mjs\"",
    "test:e2e": "node tests/run-e2e.mjs",
    "setup:git": "node scripts/setup-git.mjs",
    "land": "node scripts/land.mjs",
    "prune:local": "node scripts/prune-local.mjs",
    "deepseek:import": "node server/services/deepseek-usage-import.mjs",
    "test:e2e:raw": "node ./node_modules/@playwright/test/cli.js test --config tests/playwright.config.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.304",
    "@cursor/sdk": "1.0.38",
    "@github/copilot-sdk": "1.0.23",
    "better-sqlite3": "12.11.1",
    "express": "4.22.3",
    "qrcode-terminal": "0.12.0",
    "socket.io": "4.8.3",
    "uuid": "14.0.1",
    "web-push": "3.6.7",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "tty-console": "1.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "jsdom": "^30.0.1"
  },
  "overrides": {
    "undici": "6.28.0"
  }
}
