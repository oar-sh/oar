{
  "name": "@oar-sh/oar",
  "version": "0.9.26",
  "type": "module",
  "description": "OAR — Open Agent Relay: drive your local coding agents from any browser",
  "license": "MIT",
  "author": "Simon",
  "homepage": "https://oar.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oar-sh/oar.git"
  },
  "bugs": {
    "url": "https://github.com/oar-sh/oar/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "main": "server/server.js",
  "bin": {
    "oar": "./bin/oar.js"
  },
  "files": [
    "bin/",
    "server/",
    "!server/**/*.test.mjs",
    "!server/**/*-test-harness.mjs",
    "!server/**/*-test-fixtures.mjs",
    "!server/**/fixtures/",
    "!server/README.md",
    "!server/data/",
    "!server/logs/",
    "!server/backups/",
    "!server/config.json",
    "!server/uploads/",
    "server/uploads/README.md",
    "shared/",
    "!shared/**/*.test.mjs",
    "!shared/**/*-test-harness.mjs",
    "!shared/**/*-test-fixtures.mjs",
    "!shared/**/fixtures/",
    ".github/extensions/web-relay/",
    "!.github/extensions/web-relay/**/*.test.mjs",
    "!.github/extensions/web-relay/README.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server/server.js",
    "copilot:relay": "gh copilot -- --allow-all",
    "test": "node --import ./scripts/node-test-keep-alive.mjs --import ./scripts/node-test-worktree-guard.mjs --test \"server/**/*.test.mjs\" \"shared/**/*.test.mjs\" \".github/extensions/web-relay/**/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "test:agents:smoke": "node --test \"tests/agents/**/*.test.mjs\"",
    "test:packed-update": "node --test tests/packed-update/packed-update.test.mjs",
    "test:e2e": "node tests/run-e2e.mjs",
    "setup:git": "node scripts/setup-git.mjs",
    "land": "node scripts/land.mjs",
    "prune:local": "node scripts/prune-local.mjs",
    "deepseek:import": "node server/services/deepseek-usage-import.mjs",
    "test:e2e:raw": "node ./node_modules/@playwright/test/cli.js test --config tests/playwright.config.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "qrcode-terminal": "0.12.0",
    "socket.io": "4.8.4",
    "web-push": "3.6.7",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@anthropic-ai/sdk": "0.116.0",
    "@cursor/sdk": "1.3.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "^1.60.0",
    "jsdom": "^30.0.1",
    "katex": "0.19.1",
    "koffi": "3.3.4",
    "marked": "15.0.12",
    "zod": "4.6.7"
  },
  "overrides": {
    "undici": "6.28.0"
  }
}
